<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (dark, matches the app's #111214 surface). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/gs_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/gs_bg</item>
    </style>

    <!-- Android 12+ system splash: dark background with the waveform logo. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gs_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/gs_bg</item>
    </style>
</resources>
